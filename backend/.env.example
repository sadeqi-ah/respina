# Local development outside Docker: copy to backend/.env (gitignored).
# Inside compose, the root .env is used instead and this file is not read.
DJANGO_SECRET_KEY=change-me-local-dev-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://cloudpanel_owner:change-me-owner@localhost:5432/cloudpanel
JWT_PRIVATE_KEY_PATH=../secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../secrets/jwt_public.pem
